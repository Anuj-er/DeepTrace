# DeepTrace Backend Environment Variables

# MongoDB Connection String (Atlas)
# Get a free cluster at https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# JWT Secret Key for Authentication
# Generate a random secure string: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-secret

# Cloudinary Configuration (optional — falls back to local storage)
# Get your API Environment variable from https://cloudinary.com/console
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# AI Model Configuration
# HuggingFace model ID (downloads automatically ~200MB on first run)
DEEPTRACE_MODEL=dima806/deepfake_vs_real_image_detection

# For production deployment — set the frontend URL for CORS
# CORS_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173
